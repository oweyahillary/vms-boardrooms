# ── DATABASE ───────────────────────────────────────────────────────────
# Use Session Mode pooler URL from Supabase (Settings > Database > Session Mode)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── SUPABASE STORAGE ───────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-anon-public-key

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# ── APP ────────────────────────────────────────────────────────────────
# Public base URL of the deployed single service (used to build invite links).
# On Render, set this to your service URL, e.g. https://vms.onrender.com
APP_URL=http://localhost:3000

# Optional: extra CORS origins for local dev (comma-separated).
# Leave blank in production — the frontend is served same-origin.
CORS_ORIGINS=
